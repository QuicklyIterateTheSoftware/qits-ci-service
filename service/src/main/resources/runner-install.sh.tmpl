#!/bin/sh
# Starts qits-ci-runner on this host as a docker container, set up as one qits-ci runner.
# For a Linux host with docker, as root (or a member of the docker group).
#
# Not run by hand: the CI UI's Runners page hands out ONE LINE that downloads this script and pipes
# it into `sudo env QITS_CI_RUNNER_URL=... QITS_CI_RUNNER_ID=... QITS_CI_RUNNER_REGISTRATION_TOKEN=...
# QITS_CI_RUNNER_SLOTS=... sh`. So this script carries no secret and names no runner: the four values
# come from its environment, and it runs in a shell of its own, so a refusal ends that shell and never
# the one it was pasted into. Everything below is inside main(), called on the last line, so a
# download cut short runs nothing at all.
#
# The runner is a native binary inside the image named below. The container gets the host's docker
# socket, because it starts every step's container beside itself, and a named volume for its state
# (client.json, the credential its registration produced). It joins no network of its own and
# restarts with the docker daemon until it is removed. A newer runner replaces this container by
# itself when qits-ci tells it to (the Upgrade frame): it pulls the pinned image and starts a
# successor under the same labels, so this script is needed once per host, not once per version.
#
# Running it again with a fresh token — the CI UI's "replace registration token" hands out a new line
# — pulls the pinned image, removes every container of this runner and starts a new one with the new
# token. The state volume is left alone: the runner registers again by itself when the token differs
# from the one it registered with.
#
# Rendered by qits-ci-service from service/src/main/resources/runner-install.sh.tmpl, with only the
# pinned runner image filled in. Every tool comes from PATH, which is what lets
# qits-ci-runner-daemon's scripts/test-install-contract.sh run a rendering against a stub docker.
set -eu

refuse() {
  echo "qits-ci-runner install: $*" >&2
  exit 1
}

# One sentence per missing value, naming it, and a charset that is literal everywhere this script
# passes it on: no whitespace, quote, backslash, $ or newline reaches docker's arguments.
require() { # $1 = name, $2 = value
  [ -n "$2" ] || refuse "$1 is not set; paste the whole line from the CI UI's Runners page."
  case "$2" in
    *[!A-Za-z0-9._~+/=:-]*) refuse "$1 carries a character this script will not pass to the runner." ;;
  esac
}

main() {
  require QITS_CI_RUNNER_URL "${QITS_CI_RUNNER_URL:-}"
  require QITS_CI_RUNNER_ID "${QITS_CI_RUNNER_ID:-}"
  require QITS_CI_RUNNER_REGISTRATION_TOKEN "${QITS_CI_RUNNER_REGISTRATION_TOKEN:-}"
  require QITS_CI_RUNNER_SLOTS "${QITS_CI_RUNNER_SLOTS:-}"

  image='{{IMAGE}}'
  registry="${image%%/*}"
  version="${image##*:}"
  id8=$(printf '%.8s' "$QITS_CI_RUNNER_ID")
  name="qits-ci-runner-$id8-$version"
  volume="qits-ci-runner-state-$id8"

  docker version >/dev/null 2>&1 \
    || refuse "docker does not answer (docker version failed); install docker, or run this as root."

  # The registration token is this host's registry login for exactly one pull, in a docker config of
  # its own: never the host's ~/.docker/config.json, and gone again whatever the pull answered.
  config=$(mktemp -d)
  trap 'rm -rf "$config"' EXIT INT TERM
  printf '%s\n' "$QITS_CI_RUNNER_REGISTRATION_TOKEN" \
    | docker --config "$config" login "$registry" -u token --password-stdin >/dev/null 2>&1 \
    || refuse "could not log in to $registry with the registration token."
  docker --config "$config" pull "$image" >/dev/null \
    || refuse "could not pull $image."
  rm -rf "$config"

  # Pulled first, so a failed pull leaves a runner that is already here running. Then every
  # container of this runner goes, whatever version it is: one runner, one container.
  previous=$(docker ps -aq --filter "label=qits.ci.runner.process=$QITS_CI_RUNNER_ID")
  if [ -n "$previous" ]; then
    # shellcheck disable=SC2086 # one container id per word
    docker rm -f $previous >/dev/null
  fi

  # The four values reach the container by name (-e NAME), from this script's environment, so the
  # token is on no command line a `ps` could read.
  docker run -d \
    --name "$name" \
    --label "qits.ci.runner.process=$QITS_CI_RUNNER_ID" \
    --label "qits.ci.runner.version=$version" \
    --restart=unless-stopped \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$volume:/var/lib/qits-ci-runner" \
    -e QITS_CI_RUNNER_URL \
    -e QITS_CI_RUNNER_ID \
    -e QITS_CI_RUNNER_SLOTS \
    -e QITS_CI_RUNNER_REGISTRATION_TOKEN \
    "$image" >/dev/null \
    || refuse "could not start $name from $image."

  echo "qits-ci-runner started; watch: docker logs -f $name"
}

main "$@"

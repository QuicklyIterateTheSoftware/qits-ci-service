#!/bin/sh
# Installs (or replaces) the qits CI runner on this host: ONE docker container, supervised by docker's
# own restart policy. For any Linux host with docker, run by root or by a user who may use docker.
#
# THIS FILE IS THE REFERENCE IMPLEMENTATION OF THE INSTALL CONTRACT. qits-ci-service renders the
# script it serves at `GET /ci/api/runners/install.sh` from its template
# (service/src/main/resources/runner-install.sh.tmpl), and that template is written to match this
# file EXACTLY, with only the two rendered values below (`image=` and `version=`) differing.
# qits-ci-runner-daemon's scripts/test-install-contract.sh runs this file against a stub docker and
# asserts the contract; change the two together, and change the runner's successor argv
# (RunnerArgv.runSuccessor) with them, since a runner rolls itself over into the same shape.
#
# Not run by hand: the CI UI's Runners page hands out ONE LINE that downloads this script and pipes
# it into `sudo env QITS_CI_RUNNER_URL=... QITS_CI_RUNNER_ID=... QITS_CI_RUNNER_REGISTRATION_TOKEN=...
# QITS_CI_RUNNER_SLOTS=... sh`. So this script carries no secret and names no runner: the four values
# come from its environment, and it runs in a shell of its own, so a refusal ends that shell and never
# the one it was pasted into. Everything below is inside main(), called on the last line, so a
# download cut short runs nothing at all.
#
# WHAT IT DOES:
#
#   1. refuses, one sentence each, when a value is missing or docker does not answer;
#   2. logs in to the platform's registry with the registration token, in a throwaway docker config
#      that is deleted right after, and pulls the runner image — the host's own docker config is
#      never written;
#   3. removes every container of this runner (label qits.ci.runner.process=<id>) — a re-run
#      REPLACES the runner, and a re-run with a new token is how a registration is rotated;
#   4. keeps the runner's state volume but removes client.json from it, so the token it was just
#      given is the one the runner registers with;
#   5. starts the runner container, and prints how to watch it.
#
# The registration token appears in no line this script prints and in no command line: the login
# reads it on stdin, and the container gets it as `-e QITS_CI_RUNNER_REGISTRATION_TOKEN`, docker's
# own "take the value from my environment" form.
set -eu

refuse() {
  echo "qits-ci-runner install: $*" >&2
  exit 1
}

# One sentence per missing value, naming it, and a charset that keeps every value one plain word: they
# become container names, labels and environment values.
require() { # $1 = name, $2 = value
  [ -n "$2" ] || refuse "$1 is not set; paste the whole line from the CI UI's Runners page."
  case "$2" in
    *[!A-Za-z0-9._~+/=:-]*) refuse "$1 carries a character this script will not hand to docker." ;;
  esac
}

main() {
  require QITS_CI_RUNNER_URL "${QITS_CI_RUNNER_URL:-}"
  require QITS_CI_RUNNER_ID "${QITS_CI_RUNNER_ID:-}"
  require QITS_CI_RUNNER_REGISTRATION_TOKEN "${QITS_CI_RUNNER_REGISTRATION_TOKEN:-}"
  require QITS_CI_RUNNER_SLOTS "${QITS_CI_RUNNER_SLOTS:-}"

  # RENDERED: the image qits-ci pins (CiRunnerBinary.IMAGE_REPOSITORY on its registry's public host)
  # and its version, which is also the container name's suffix and the version label.
  image='{{IMAGE}}'
  version="${image##*:}"

  registry="${image%%/*}"
  id8=$(printf '%s' "$QITS_CI_RUNNER_ID" | cut -c1-8)
  name="qits-ci-runner-$id8-$version"
  volume="qits-ci-runner-state-$id8"

  command -v docker >/dev/null 2>&1 || refuse "docker is not on PATH; install docker first."
  docker version >/dev/null 2>&1 \
    || refuse "docker does not answer (docker version failed); start it, or run this as root or as a user in the docker group."

  # The registry answers an anonymous pull with 401, and the host's docker config is nobody's to
  # write: a login there would outlive this script and serve every docker user on the host. So the
  # login lives in a directory of its own (mktemp -d is 0700) and is gone before anything else runs.
  config=$(mktemp -d)
  if ! printf '%s' "$QITS_CI_RUNNER_REGISTRATION_TOKEN" \
      | docker --config "$config" login "$registry" -u token --password-stdin >/dev/null 2>&1; then
    rm -rf "$config"
    refuse "the registry $registry refused the registration token; paste a fresh line from the CI UI."
  fi
  if ! docker --config "$config" pull "$image" >/dev/null; then
    rm -rf "$config"
    refuse "could not pull $image."
  fi
  rm -rf "$config"

  # Whatever runs as this runner now goes: an earlier install, a runner that rolled itself over, an
  # exited predecessor. The step containers carry a different label and are the new runner's boot
  # sweep's to remove.
  for container in $(docker ps -aq --filter "label=qits.ci.runner.process=$QITS_CI_RUNNER_ID"); do
    docker rm -f "$container" >/dev/null
  done

  # The volume is KEPT — it is the runner's state — but its client goes: the runner registers with
  # the token in this line, which on a re-run is a new one.
  docker run --rm --entrypoint rm -v "$volume:/var/lib/qits-ci-runner" "$image" \
    -f /var/lib/qits-ci-runner/client.json

  # `-e NAME` hands docker the value from its own environment, so the token is in no command line.
  export QITS_CI_RUNNER_REGISTRATION_TOKEN

  # THE CONTAINER CONTRACT. docker's restart policy is the supervisor; the socket is how the runner
  # starts its steps and, when told to update, its own successor; the volume holds its client. No
  # --network: docker's default bridge. The runner's own label is qits.ci.runner.process — never
  # qits.ci.runner, which the runner's boot sweep removes.
  set -- \
    -d \
    --name "$name" \
    --restart unless-stopped \
    --label "qits.ci.runner.process=$QITS_CI_RUNNER_ID" \
    --label "qits.ci.runner.version=$version" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$volume:/var/lib/qits-ci-runner" \
    -e "QITS_CI_RUNNER_URL=$QITS_CI_RUNNER_URL" \
    -e "QITS_CI_RUNNER_ID=$QITS_CI_RUNNER_ID" \
    -e "QITS_CI_RUNNER_SLOTS=$QITS_CI_RUNNER_SLOTS" \
    -e QITS_CI_RUNNER_REGISTRATION_TOKEN
  # The operator's tuning, when the line (or the shell) set any. Everything else has its default.
  for tuning in QITS_CI_RUNNER_DOCKER_TIMEOUT QITS_CI_RUNNER_BUILDKIT_IMAGE \
      QITS_CI_RUNNER_BUILDKIT_HTTP_REGISTRIES QITS_CI_RUNNER_BUILDKIT_REGISTRY_MIRRORS \
      QITS_CI_RUNNER_ROLLOVER_TIMEOUT; do
    value=$(printenv "$tuning" || true)
    if [ -n "$value" ]; then
      case "$value" in
        *[!A-Za-z0-9._~+/=:,-]*) refuse "$tuning carries a character this script will not hand to docker." ;;
      esac
      set -- "$@" -e "$tuning=$value"
    fi
  done
  docker run "$@" "$image" >/dev/null

  echo "qits-ci-runner started; watch: docker logs -f $name"
}

main "$@"
